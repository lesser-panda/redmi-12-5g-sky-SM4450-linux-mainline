+	select DRM_DISPLAY_HELPER
+	help
+	  Say Y here if you want to enable support for the DSI video-mode
+	  DSC panel of the Xiaomi Redmi 12 5G (sky), panel m19_42_03_0b.
+
 config DRM_PANEL_VISIONOX_R66451
 	tristate "Visionox R66451"
 	depends on OF
