From: Andy Zhang and contributors (see kernel/third-party/README.md for imported parts)
Subject: [PATCH 0003/8] Adreno 613 (A6xx) support

Adreno 613: catalog entry (reported as revn 612 so Mesa accepts it, see docs/en/KNOWN-ISSUES.md), GMU wrapper handling,
no-SPTPRAC handling. Contains leftover E012 debug code, listed in KNOWN-ISSUES.
Based on ROCKNIX 0001/0013-0019, adapted.

Apply with: git apply (from the root of a Linux 7.3 tree).
---
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_catalog.c b/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
index 90a0c7ffb..2a075001c 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
@@ -728,6 +728,31 @@ static const struct adreno_info a6xx_gpus[] = {
 			.gmu_cgc_mode = 0x00000022,
 			.prim_fifo_threshold = 0x00080000,
 		},
+	}, {
+		.chip_ids = ADRENO_CHIP_IDS(0x06010300),
+		.family = ADRENO_6XX_GEN1,
+		.revn = 612, /* E012 workaround: Mesa 26.1.6 has no A613 (gpu_id 613) entry; A613 and A612 share one Mesa device config, so report 612 until Mesa is newer */
+		.fw = {
+			[ADRENO_FW_SQE] = "a630_sqe.fw",
+		},
+		.gmem = (SZ_128K + SZ_4K),
+		.quirks = ADRENO_QUIRK_4GB_VA,
+		.inactive_period = DRM_MSM_INACTIVE_PERIOD,
+		.funcs = &a6xx_gmuwrapper_funcs,
+		.zapfw = "a613_zap.mbn",
+		.a6xx = &(const struct a6xx_info) {
+			.hwcg = a612_hwcg,
+			.protect = &a630_protect,
+			.gbif_cx = a640_gbif,
+			.gmu_cgc_mode = 0x00020202,
+			.prim_fifo_threshold = 0x00080000,
+		},
+		.speedbins = ADRENO_SPEEDBINS(
+			{ 0, 0 },
+			{ 201, 1 },
+			{ 213, 2 },
+			{ 162, 3 },
+		),
 	}, {
 		.chip_ids = ADRENO_CHIP_IDS(0x06010500),
 		.family = ADRENO_6XX_GEN1,
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
index 6d49c51df..0ae9367b0 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
@@ -78,12 +78,17 @@ static irqreturn_t a6xx_hfi_irq(int irq, void *data)
 
 bool a6xx_gmu_sptprac_is_on(struct a6xx_gmu *gmu)
 {
+	struct a6xx_gpu *a6xx_gpu = container_of(gmu, struct a6xx_gpu, gmu);
 	u32 val;
 
 	/* This can be called from gpu state code so make sure GMU is valid */
 	if (!gmu->initialized)
 		return false;
 
+	/* Only A630 and the A615 family have SPTPRAC */
+	if (!adreno_is_a630(&a6xx_gpu->base) && !adreno_is_a615_family(&a6xx_gpu->base))
+		return true;
+
 	val = gmu_read(gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS);
 
 	return !(val &
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gpu.c b/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
index 081e79ea4..878dfd6ab 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
@@ -653,7 +653,8 @@ static void a6xx_set_hwcg(struct msm_gpu *gpu, bool state)
 
 	if (adreno_is_a630(adreno_gpu))
 		clock_cntl_on = 0x8aa8aa02;
-	else if (adreno_is_a610(adreno_gpu) || adreno_is_a612(adreno_gpu))
+	else if (adreno_is_a610(adreno_gpu) || adreno_is_a612(adreno_gpu) ||
+		 adreno_is_a613(adreno_gpu))
 		clock_cntl_on = 0xaaa8aa82;
 	else if (adreno_is_a702(adreno_gpu))
 		clock_cntl_on = 0xaaaaaa82;
@@ -898,6 +899,9 @@ static int a7xx_preempt_start(struct msm_gpu *gpu)
 	return a6xx_idle(gpu, ring) ? 0 : -EINVAL;
 }
 
+static void a6xx_cp_hw_err_irq(struct msm_gpu *gpu);
+extern u32 e012_fw_sum, e012_fw_len;
+
 static int a6xx_cp_init(struct msm_gpu *gpu)
 {
 	struct msm_ringbuffer *ring = gpu->rb[0];
@@ -924,7 +928,40 @@ static int a6xx_cp_init(struct msm_gpu *gpu)
 	OUT_RING(ring, 0x00000000);
 
 	a6xx_flush(gpu, ring);
-	return a6xx_idle(gpu, ring) ? 0 : -EINVAL;
+	if (a6xx_idle(gpu, ring))
+		return 0;
+
+	/* E012-DEBUG: remove once the A613 CP start-up is understood */
+	dev_err(gpu->dev->dev,
+		"E012 cp_init failed: RBBM_STATUS %08x STATUS3 %08x INT0 %08x HW_FAULT %08x CP_STATUS_1 %08x SQE_CNTL %08x SECVID %08x PROT_STATUS %08x ROQ_RB %08x RB_BASE %016llx SQE_BASE %016llx RB_CNTL %08x\n",
+		gpu_read(gpu, REG_A6XX_RBBM_STATUS),
+		gpu_read(gpu, REG_A6XX_RBBM_STATUS3),
+		gpu_read(gpu, REG_A6XX_RBBM_INT_0_STATUS),
+		gpu_read(gpu, REG_A6XX_CP_HW_FAULT),
+		gpu_read(gpu, REG_A6XX_CP_STATUS_1),
+		gpu_read(gpu, REG_A6XX_CP_SQE_CNTL),
+		gpu_read(gpu, REG_A6XX_RBBM_SECVID_TRUST_CNTL),
+		gpu_read(gpu, REG_A6XX_CP_PROTECT_STATUS),
+		gpu_read(gpu, REG_A6XX_CP_ROQ_AVAIL_RB),
+		gpu_read64(gpu, REG_A6XX_CP_RB_BASE),
+		gpu_read64(gpu, REG_A6XX_CP_SQE_INSTR_BASE),
+		gpu_read(gpu, REG_A6XX_CP_RB_CNTL));
+	{
+		struct a6xx_gpu *a6 = to_a6xx_gpu(to_adreno_gpu(gpu));
+		u32 *d = msm_gem_get_vaddr(a6->sqe_bo), sum = 0, i;
+
+		if (!IS_ERR(d)) {
+			for (i = 0; i < e012_fw_len; i++)
+				sum += d[i];
+			dev_err(gpu->dev->dev, "E012 fw bo now: sum %08x (written %08x) first %08x\n", sum, e012_fw_sum, d[0]);
+			msm_gem_put_vaddr(a6->sqe_bo);
+		}
+
+		dev_err(gpu->dev->dev, "E012 CP_INTERRUPT_STATUS %08x sw ring iova %llx sqe iova %llx\n",
+			gpu_read(gpu, REG_A6XX_CP_INTERRUPT_STATUS), (u64)gpu->rb[0]->iova, (u64)a6->sqe_iova);
+	}
+	a6xx_cp_hw_err_irq(gpu);
+	return -EINVAL;
 }
 
 static int a7xx_cp_init(struct msm_gpu *gpu)
@@ -1245,6 +1282,9 @@ static int hw_init(struct msm_gpu *gpu)
 		gpu_write(gpu, REG_A6XX_GBIF_QSB_SIDE1, 0x00071620);
 		gpu_write(gpu, REG_A6XX_GBIF_QSB_SIDE2, 0x00071620);
 		gpu_write(gpu, REG_A6XX_GBIF_QSB_SIDE3, 0x00071620);
+		/* A613 (gen6_3_26_0) requires GBIF_CX_CONFIG[18:16] cleared */
+		if (adreno_is_a613(adreno_gpu))
+			gpu_rmw(gpu, 0x3c00, GENMASK(18, 16), 0);
 	}
 
 	if (adreno_is_a610_family(adreno_gpu) ||
@@ -1311,7 +1351,8 @@ static int hw_init(struct msm_gpu *gpu)
 		gpu_write(gpu, REG_A7XX_CP_LPAC_PROG_FIFO_SIZE, 0x00000020);
 
 	/* Setting the mem pool size */
-	if (adreno_is_a610(adreno_gpu) || adreno_is_a612(adreno_gpu)) {
+	if (adreno_is_a610(adreno_gpu) || adreno_is_a612(adreno_gpu) ||
+	    adreno_is_a613(adreno_gpu)) {
 		gpu_write(gpu, REG_A6XX_CP_MEM_POOL_SIZE, 48);
 		gpu_write(gpu, REG_A6XX_CP_MEM_POOL_DBG_ADDR, 47);
 	} else if (adreno_is_a702(adreno_gpu)) {
@@ -1351,7 +1392,7 @@ static int hw_init(struct msm_gpu *gpu)
 		gpu_write(gpu, REG_A6XX_RBBM_INTERFACE_HANG_INT_CNTL, (1 << 30) | 0xcfffff);
 	else if (adreno_is_a690(adreno_gpu))
 		gpu_write(gpu, REG_A6XX_RBBM_INTERFACE_HANG_INT_CNTL, (1 << 30) | 0x4fffff);
-	else if (adreno_is_a619(adreno_gpu))
+	else if (adreno_is_a619(adreno_gpu) || adreno_is_a613(adreno_gpu))
 		gpu_write(gpu, REG_A6XX_RBBM_INTERFACE_HANG_INT_CNTL, (1 << 30) | 0x3fffff);
 	else if (adreno_is_a610(adreno_gpu) || adreno_is_a702(adreno_gpu))
 		gpu_write(gpu, REG_A6XX_RBBM_INTERFACE_HANG_INT_CNTL, (1 << 30) | 0x3ffff);
diff --git a/drivers/gpu/drm/msm/adreno/adreno_gpu.c b/drivers/gpu/drm/msm/adreno/adreno_gpu.c
index 5832dc25d..f77e6dc29 100644
--- a/drivers/gpu/drm/msm/adreno/adreno_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/adreno_gpu.c
@@ -11,6 +11,7 @@
 #include <linux/firmware/qcom/qcom_pas.h>
 #include <linux/firmware/qcom/qcom_scm.h>
 #include <linux/kernel.h>
+#include <linux/dma-map-ops.h>
 #include <linux/of_reserved_mem.h>
 #include <linux/pm_opp.h>
 #include <linux/slab.h>
@@ -641,6 +642,10 @@ int adreno_load_fw(struct adreno_gpu *adreno_gpu)
 	return 0;
 }
 
+u32 e012_fw_sum, e012_fw_len;
+EXPORT_SYMBOL_GPL(e012_fw_sum);
+EXPORT_SYMBOL_GPL(e012_fw_len);
+
 struct drm_gem_object *adreno_fw_create_bo(struct msm_gpu *gpu,
 		const struct firmware *fw, u64 *iova)
 {
@@ -655,6 +660,22 @@ struct drm_gem_object *adreno_fw_create_bo(struct msm_gpu *gpu,
 
 	memcpy(ptr, &fw->data[4], fw->size - 4);
 
+	/* E012-DEBUG: is the data in the BO what the CPU wrote? */
+	{
+		u32 *s = (u32 *)&fw->data[4], *d = ptr, sum_s = 0, sum_d = 0, i, bad = 0;
+
+		for (i = 0; i < (fw->size - 4) / 4; i++) {
+			sum_s += s[i];
+			sum_d += d[i];
+			bad += s[i] != d[i];
+		}
+		e012_fw_sum = sum_s;
+		e012_fw_len = (fw->size - 4) / 4;
+		dev_err(gpu->dev->dev, "E012 fw bo: %u dwords src sum %08x readback sum %08x mismatches %u first %08x/%08x iova %llx coherent drm %d gpu %d\n",
+			e012_fw_len, sum_s, sum_d, bad, s[0], d[0], (u64)*iova,
+			dev_is_dma_coherent(gpu->dev->dev), dev_is_dma_coherent(&gpu->pdev->dev));
+	}
+
 	msm_gem_put_vaddr(bo);
 
 	return bo;
diff --git a/drivers/gpu/drm/msm/adreno/adreno_gpu.h b/drivers/gpu/drm/msm/adreno/adreno_gpu.h
index 114a40f79..a13c89412 100644
--- a/drivers/gpu/drm/msm/adreno/adreno_gpu.h
+++ b/drivers/gpu/drm/msm/adreno/adreno_gpu.h
@@ -421,6 +421,11 @@ static inline int adreno_is_a612(const struct adreno_gpu *gpu)
 	return gpu->info->chip_ids[0] == 0x06010200;
 }
 
+static inline int adreno_is_a613(const struct adreno_gpu *gpu)
+{
+	return gpu->info->chip_ids[0] == 0x06010300;
+}
+
 static inline bool adreno_has_rgmu(const struct adreno_gpu *gpu)
 {
 	return adreno_is_a612(gpu);
@@ -502,6 +507,7 @@ static inline int adreno_is_a610_family(const struct adreno_gpu *gpu)
 		return false;
 	return adreno_is_a610(gpu) ||
 	       adreno_is_a612(gpu) ||
+	       adreno_is_a613(gpu) ||
 	       adreno_is_a702(gpu);
 }
 
