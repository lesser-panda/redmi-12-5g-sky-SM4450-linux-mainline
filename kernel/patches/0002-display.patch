+#include <linux/of.h>
 #include <drm/drm_managed.h>
 
 #include <drm/display/drm_dsc_helper.h>
@@ -65,6 +66,13 @@ static int _dsc_calc_output_buf_max_addr(struct dpu_hw_dsc *hw_dsc, int num_soft
 	if (hw_dsc->caps->features & BIT(DPU_DSC_NATIVE_42x_EN))
 		max_addr /= 2;
 
+	/*
+	 * SM4450's DSC block has only 600 bytes of rate buffer, not 2400 (sky-linux
+	 * 0003, root cause of slice-shaped noise). TECH_DEBT: move into the catalog.
+	 */
+	if (of_machine_is_compatible("qcom,sm4450"))
+		max_addr = 600 / num_softslice;
+
 	return max_addr - 1;
 };
 
