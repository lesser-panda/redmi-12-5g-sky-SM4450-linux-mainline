diff --git a/drivers/input/touchscreen/focaltech-ft8720-spi.c b/drivers/input/touchscreen/focaltech-ft8720-spi.c
new file mode 100644
index 000000000..9b344706d
--- /dev/null
+++ b/drivers/input/touchscreen/focaltech-ft8720-spi.c
@@ -0,0 +1,433 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * FocalTech FT8720 SPI touchscreen (TDDI) driver.
+ *
+ * Written for the Redmi 12 5G (sky, SM4450). The wire protocol was derived
+ * from SPI traces of the vendor driver (Focaltech V3.4 20211214) running on
+ * the device and from the vendor devicetree; no vendor source code was used.
+ *
+ * Frame format (every command, one SPI transfer, chip select kept low):
+ *   tx: [cmd][ctrl][len_hi][len_lo] + 3 dummy bytes + payload      (write, ctrl 0x00)
+ *   tx: [reg][0xa0][len_hi][len_lo] + zeros; rx: 7 filler bytes, len data
+ *       bytes, CRC16-Kermit (low byte first)                       (read, ctrl 0xa0)
+ *
+ * The controller runs from RAM: after every reset the host must download the
+ * firmware (program RAM at 0x000000, data RAM at 0xd00000) and start it.
+ */
+
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/input/touchscreen.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/slab.h>
+#include <linux/spi/spi.h>
+#include <linux/unaligned.h>
+
+#define FTS_MAX_POINTS		10
+#define FTS_REPORT_REG		0x01
+#define FTS_REPORT_LEN		90
+#define FTS_HDR_LEN		7
+#define FTS_BUF_LEN		4096
+#define FTS_CHUNK		4080
+
+#define FTS_REG_CHIP_ID		0xa3
+#define FTS_REG_POWER		0xa5
+#define FTS_REG_FW_VER		0xa6
+#define FTS_REG_STATE_B5	0xb5
+#define FTS_REG_STATE_B6	0xb6
+
+#define FTS_CMD_BOOT		0x55
+#define FTS_CMD_READ_BOOT_ID	0x90
+#define FTS_CMD_SET_ADDR	0xad
+#define FTS_CMD_WRITE_RAM	0xae
+#define FTS_CMD_ECC_RUN		0xcc
+#define FTS_CMD_ECC_READ	0xcd
+#define FTS_CMD_ECC_STATUS	0xce
+#define FTS_CMD_START_APP	0x08
+
+#define FTS_ECC_DONE		0xa5
+#define FTS_DRAM_BASE		0xd00000
+
+struct fts_ts {
+	struct spi_device *spi;
+	struct input_dev *input;
+	struct gpio_desc *reset;
+	struct touchscreen_properties prop;
+	struct mutex lock;
+	u8 *tx;
+	u8 *rx;
+	u8 fw_version;
+};
+
+static int fts_xfer(struct fts_ts *ts, unsigned int len)
+{
+	struct spi_transfer t = {
+		.tx_buf = ts->tx,
+		.rx_buf = ts->rx,
+		.len = len,
+	};
+
+	return spi_sync_transfer(ts->spi, &t, 1);
+}
+
+/* CRC16-Kermit (reflected poly 0x8408, init 0xffff), as used on the wire */
+static u16 fts_crc(const u8 *p, unsigned int n)
+{
+	u16 crc = 0xffff;
+	unsigned int i;
+	int b;
+
+	for (i = 0; i < n; i++) {
+		crc ^= p[i];
+		for (b = 0; b < 8; b++)
+			crc = (crc >> 1) ^ ((crc & 1) ? 0x8408 : 0);
+	}
+	return crc;
+}
+
+/* Read @n bytes of register @reg into @out, checking the trailing CRC16. */
+static int fts_read(struct fts_ts *ts, u8 reg, u8 *out, unsigned int n)
+{
+	unsigned int tot = FTS_HDR_LEN + n + 2;
+	u16 want, got;
+	int ret;
+
+	if (tot > FTS_BUF_LEN)
+		return -EINVAL;
+
+	memset(ts->tx, 0, tot);
+	ts->tx[0] = reg;
+	ts->tx[1] = 0xa0;
+	ts->tx[2] = n >> 8;
+	ts->tx[3] = n;
+
+	ret = fts_xfer(ts, tot);
+	if (ret)
+		return ret;
+
+	want = fts_crc(ts->rx + FTS_HDR_LEN, n);
+	got = ts->rx[FTS_HDR_LEN + n] | (ts->rx[FTS_HDR_LEN + n + 1] << 8);
+	if (want != got)
+		return -EBADMSG;
+
+	memcpy(out, ts->rx + FTS_HDR_LEN, n);
+	return 0;
+}
+
+static int fts_write(struct fts_ts *ts, u8 cmd, const u8 *data, unsigned int n)
+{
+	unsigned int tot = n ? FTS_HDR_LEN + n : 4;
+
+	if (tot > FTS_BUF_LEN)
+		return -EINVAL;
+
+	memset(ts->tx, 0, tot);
+	ts->tx[0] = cmd;
+	ts->tx[2] = n >> 8;
+	ts->tx[3] = n;
+	if (n)
+		memcpy(ts->tx + FTS_HDR_LEN, data, n);
+
+	return fts_xfer(ts, tot);
+}
+
+static int fts_set_addr(struct fts_ts *ts, u32 addr)
+{
+	u8 p[3] = { addr >> 16, addr >> 8, addr };
+
+	return fts_write(ts, FTS_CMD_SET_ADDR, p, 3);
+}
+
+static void fts_hw_reset(struct fts_ts *ts)
+{
+	gpiod_set_value_cansleep(ts->reset, 1);	/* asserted = pin low */
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(ts->reset, 0);
+	usleep_range(8000, 9000);
+}
+
+static int fts_enter_boot(struct fts_ts *ts)
+{
+	u8 id[2];
+	int i, ret;
+
+	for (i = 0; i < 5; i++) {
+		fts_hw_reset(ts);
+		ret = fts_write(ts, FTS_CMD_BOOT, NULL, 0);
+		if (ret)
+			return ret;
+		msleep(8);
+		ret = fts_read(ts, FTS_CMD_READ_BOOT_ID, id, 2);
+		if (!ret && id[0] == 0x87 && id[1] == 0x20)
+			return 0;
+	}
+
+	dev_err(&ts->spi->dev, "no boot id (last %02x%02x, ret %d)\n",
+		id[0], id[1], ret);
+	return -ENODEV;
+}
+
+/* Write @len bytes of @data to RAM at @base in chunks, then verify ECC. */
+static int fts_load_block(struct fts_ts *ts, u32 base, const u8 *data, u32 len,
+			  const char *what)
+{
+	u32 off, c;
+	u8 b[2], st = 0;
+	u8 p[6];
+	int i, ret;
+
+	for (off = 0; off < len; off += c) {
+		c = min_t(u32, len - off, FTS_CHUNK);
+		ret = fts_set_addr(ts, base + off);
+		if (ret)
+			return ret;
+		usleep_range(200, 400);
+		ret = fts_write(ts, FTS_CMD_WRITE_RAM, data + off, c);
+		if (ret)
+			return ret;
+		usleep_range(1500, 2000);
+	}
+
+	/* the ECC command carries 3 address bytes (0) and the 3-byte length */
+	p[0] = 0; p[1] = 0; p[2] = 0;
+	p[3] = len >> 16; p[4] = len >> 8; p[5] = len;
+	ret = fts_write(ts, FTS_CMD_ECC_RUN, p, 6);
+	if (ret)
+		return ret;
+	usleep_range(2000, 3000);
+
+	for (i = 0; i < 100; i++) {
+		ret = fts_read(ts, FTS_CMD_ECC_STATUS, &st, 1);
+		if (!ret && st == FTS_ECC_DONE)
+			break;
+		usleep_range(1000, 2000);
+	}
+	if (st != FTS_ECC_DONE) {
+		dev_err(&ts->spi->dev, "%s ecc not finished (%02x)\n", what, st);
+		return -ETIMEDOUT;
+	}
+
+	ret = fts_read(ts, FTS_CMD_ECC_READ, b, 2);
+	if (ret)
+		return ret;
+	dev_dbg(&ts->spi->dev, "%s ecc %04x\n", what, get_unaligned_be16(b));
+	return 0;
+}
+
+static int fts_download(struct fts_ts *ts, const struct firmware *fw)
+{
+	const u8 *d = fw->data;
+	u32 pram, dram;
+	int ret;
+
+	if (fw->size < 0x110)
+		return -EINVAL;
+
+	/* lengths (in 16-bit words) with their bitwise inverse next to them */
+	pram = get_unaligned_be16(d + 0x100);
+	if ((pram ^ get_unaligned_be16(d + 0x102)) != 0xffff)
+		return -EINVAL;
+	dram = get_unaligned_be16(d + 0x108);
+	if ((dram ^ get_unaligned_be16(d + 0x10a)) != 0xffff)
+		return -EINVAL;
+	pram *= 2;
+	dram *= 2;
+	if (!pram || pram + dram > fw->size)
+		return -EINVAL;
+
+	ret = fts_enter_boot(ts);
+	if (ret)
+		return ret;
+
+	ret = fts_load_block(ts, 0, d, pram, "pram");
+	if (ret)
+		return ret;
+	ret = fts_load_block(ts, FTS_DRAM_BASE, d + pram, dram, "dram");
+	if (ret)
+		return ret;
+
+	ret = fts_write(ts, FTS_CMD_START_APP, NULL, 0);
+	if (ret)
+		return ret;
+	msleep(30);
+
+	return 0;
+}
+
+static void fts_report(struct fts_ts *ts, const u8 *f)
+{
+	DECLARE_BITMAP(seen, FTS_MAX_POINTS) = { 0 };
+	unsigned int count = f[1] & 0x0f;
+	unsigned int i;
+
+	if (f[1] == 0xff)
+		count = 0;
+
+	for (i = 0; i < count && i < FTS_MAX_POINTS; i++) {
+		const u8 *q = f + 2 + i * 6;
+		unsigned int id = q[2] >> 4;
+		unsigned int ev = q[0] >> 6;
+		unsigned int x = ((q[0] & 0x0f) << 8) | q[1];
+		unsigned int y = ((q[2] & 0x0f) << 8) | q[3];
+
+		if (id >= FTS_MAX_POINTS || ev == 1 || ev == 3)
+			continue;
+
+		input_mt_slot(ts->input, id);
+		input_mt_report_slot_state(ts->input, MT_TOOL_FINGER, true);
+		touchscreen_report_pos(ts->input, &ts->prop, x, y, true);
+		input_report_abs(ts->input, ABS_MT_PRESSURE, q[4]);
+		input_report_abs(ts->input, ABS_MT_TOUCH_MAJOR, q[5] >> 4);
+		__set_bit(id, seen);
+	}
+
+	for (i = 0; i < FTS_MAX_POINTS; i++) {
+		if (test_bit(i, seen))
+			continue;
+		input_mt_slot(ts->input, i);
+		input_mt_report_slot_inactive(ts->input);
+	}
+
+	input_mt_sync_frame(ts->input);
+	input_sync(ts->input);
+}
+
+static irqreturn_t fts_irq(int irq, void *data)
+{
+	struct fts_ts *ts = data;
+	u8 frame[FTS_REPORT_LEN];
+	int ret;
+
+	mutex_lock(&ts->lock);
+	ret = fts_read(ts, FTS_REPORT_REG, frame, FTS_REPORT_LEN);
+	mutex_unlock(&ts->lock);
+	if (ret) {
+		dev_dbg_ratelimited(&ts->spi->dev, "report read failed: %d\n", ret);
+		return IRQ_HANDLED;
+	}
+
+	if ((frame[0] & 0xf0) != 0x90) {
+		dev_dbg_ratelimited(&ts->spi->dev, "unexpected report header %02x\n",
+				    frame[0]);
+		return IRQ_HANDLED;
+	}
+
+	fts_report(ts, frame);
+	return IRQ_HANDLED;
+}
+
+static int fts_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	const struct firmware *fw;
+	const char *fwname;
+	struct fts_ts *ts;
+	u8 id, b;
+	int ret;
+
+	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
+	if (!ts)
+		return -ENOMEM;
+
+	ts->spi = spi;
+	mutex_init(&ts->lock);
+	ts->tx = devm_kzalloc(dev, FTS_BUF_LEN, GFP_KERNEL);
+	ts->rx = devm_kzalloc(dev, FTS_BUF_LEN, GFP_KERNEL);
+	if (!ts->tx || !ts->rx)
+		return -ENOMEM;
+
+	spi->mode = SPI_MODE_0;
+	spi->bits_per_word = 8;
+	ret = spi_setup(spi);
+	if (ret)
+		return ret;
+
+	ts->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ts->reset))
+		return dev_err_probe(dev, PTR_ERR(ts->reset), "reset gpio\n");
+
+	ret = device_property_read_string(dev, "firmware-name", &fwname);
+	if (ret)
+		return dev_err_probe(dev, ret, "firmware-name\n");
+
+	ret = request_firmware(&fw, fwname, dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "request %s\n", fwname);
+
+	ret = fts_download(ts, fw);
+	release_firmware(fw);
+	if (ret)
+		return dev_err_probe(dev, ret, "firmware download\n");
+
+	ret = fts_read(ts, FTS_REG_CHIP_ID, &id, 1);
+	if (ret || id != 0x87)
+		return dev_err_probe(dev, ret ? ret : -ENODEV,
+				     "application not running (id %02x)\n", id);
+	ret = fts_read(ts, FTS_REG_FW_VER, &ts->fw_version, 1);
+	if (ret)
+		return ret;
+
+	/* state recovery step seen in the vendor trace after starting the app */
+	fts_read(ts, FTS_REG_STATE_B5, &b, 1);
+	b = 0;
+	fts_write(ts, FTS_REG_STATE_B6, &b, 1);
+
+	ts->input = devm_input_allocate_device(dev);
+	if (!ts->input)
+		return -ENOMEM;
+
+	ts->input->name = "FocalTech FT8720 touchscreen";
+	ts->input->id.bustype = BUS_SPI;
+	input_set_abs_params(ts->input, ABS_MT_POSITION_X, 0, 1079, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_POSITION_Y, 0, 2459, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_PRESSURE, 0, 255, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_TOUCH_MAJOR, 0, 15, 0, 0);
+	touchscreen_parse_properties(ts->input, true, &ts->prop);
+
+	ret = input_mt_init_slots(ts->input, FTS_MAX_POINTS, INPUT_MT_DIRECT);
+	if (ret)
+		return ret;
+
+	ret = devm_request_threaded_irq(dev, spi->irq, NULL, fts_irq,
+					IRQF_ONESHOT, "focaltech-ft8720", ts);
+	if (ret)
+		return dev_err_probe(dev, ret, "irq\n");
+
+	ret = input_register_device(ts->input);
+	if (ret)
+		return ret;
+
+	dev_info(dev, "FT8720 ready, firmware version 0x%02x\n", ts->fw_version);
+	return 0;
+}
+
+static const struct of_device_id fts_of_match[] = {
+	{ .compatible = "focaltech,ft8720-spi" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, fts_of_match);
+
+static const struct spi_device_id fts_spi_id[] = {
+	{ "ft8720-spi" },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, fts_spi_id);
+
+static struct spi_driver fts_driver = {
+	.driver = {
+		.name = "focaltech-ft8720-spi",
+		.of_match_table = fts_of_match,
+	},
+	.id_table = fts_spi_id,
+	.probe = fts_probe,
+};
+module_spi_driver(fts_driver);
+
+MODULE_DESCRIPTION("FocalTech FT8720 SPI touchscreen driver");
+MODULE_LICENSE("GPL");
