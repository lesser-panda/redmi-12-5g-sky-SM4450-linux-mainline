From: Andy Zhang and contributors (see kernel/third-party/README.md for imported parts)
Subject: [PATCH 0005/8] FocalTech FT8720 SPI touchscreen and input changes

focaltech-ft8720-spi.c: new driver written for this project (SPI touchscreen with host-side firmware download).
edt-ft5x06: follow the panel power state (ROCKNIX 0061). rsinput/aw88166 are ROCKNIX files kept so the tree matches what was built; they are unused on this phone.

Apply with: git apply (from the root of a Linux 7.3 tree).
---
diff --git a/Documentation/devicetree/bindings/input/touchscreen/focaltech,ft8720-spi.yaml b/Documentation/devicetree/bindings/input/touchscreen/focaltech,ft8720-spi.yaml
new file mode 100644
index 000000000..76e55b8d5
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/touchscreen/focaltech,ft8720-spi.yaml
@@ -0,0 +1,71 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/focaltech,ft8720-spi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: FocalTech FT8720 SPI touchscreen controller
+
+maintainers:
+  - Unassigned <unassigned@example.invalid>
+
+description:
+  FocalTech FT8720 touch and display driver IC (TDDI) connected over SPI. The
+  controller executes from RAM and needs its firmware downloaded by the host
+  after every hardware reset.
+
+allOf:
+  - $ref: touchscreen.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: focaltech,ft8720-spi
+
+  reg:
+    maxItems: 1
+
+  spi-max-frequency:
+    maximum: 9600000
+
+  interrupts:
+    maxItems: 1
+    description: Falling edge asserted when a touch report is ready.
+
+  reset-gpios:
+    maxItems: 1
+    description: Active-low reset line.
+
+  firmware-name:
+    description: Firmware image loaded with request_firmware() at probe.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - reset-gpios
+  - firmware-name
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@0 {
+            compatible = "focaltech,ft8720-spi";
+            reg = <0>;
+            spi-max-frequency = <9600000>;
+            interrupts-extended = <&tlmm 13 IRQ_TYPE_EDGE_FALLING>;
+            reset-gpios = <&tlmm 12 GPIO_ACTIVE_LOW>;
+            firmware-name = "focaltech/ft8720-sky.bin";
+            touchscreen-size-x = <1080>;
+            touchscreen-size-y = <2460>;
+        };
+    };
+...
