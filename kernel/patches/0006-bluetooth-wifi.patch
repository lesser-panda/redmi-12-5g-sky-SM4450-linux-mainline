+/*
+ * Some chips (WCN3950 on SM4450) only reset when their supplies stay off for a few hundred ms; a quick off/on, as done by the
+ * Bluetooth driver's setup retries, leaves them in the old state. The supplies may also still be on from the previous boot stage,
+ * in which case the chip never saw a power-down: do one real off period before the first power-up.
+ */
+static void pwrseq_qcom_wcn_wait_off(struct pwrseq_qcom_wcn_ctx *ctx)
+{
+	unsigned int elapsed;
+
+	if (!ctx->pdata->pwoff_min_ms)
+		return;
+
+	if (!ctx->off_known) {
+		ctx->off_known = true;
+		if (ctx->vddio && !regulator_enable(ctx->vddio))
+			regulator_disable(ctx->vddio);
+		if (!regulator_bulk_enable(ctx->pdata->num_vregs, ctx->regs))
+			regulator_bulk_disable(ctx->pdata->num_vregs, ctx->regs);
+		ctx->last_off_jf = jiffies;
+	}
+
+	elapsed = jiffies_to_msecs(jiffies - ctx->last_off_jf);
+	if (elapsed < ctx->pdata->pwoff_min_ms)
+		msleep(ctx->pdata->pwoff_min_ms - elapsed);
+}
+
+static void pwrseq_qcom_wcn_mark_off(struct pwrseq_qcom_wcn_ctx *ctx)
+{
+	ctx->last_off_jf = jiffies;
+	ctx->off_known = true;
+}
+
 static int pwrseq_qcom_wcn_vddio_enable(struct pwrseq_device *pwrseq)
 {
 	struct pwrseq_qcom_wcn_ctx *ctx = pwrseq_device_get_drvdata(pwrseq);
 
+	pwrseq_qcom_wcn_wait_off(ctx);
+
 	return regulator_enable(ctx->vddio);
 }
 
@@ -66,7 +103,10 @@ static int pwrseq_qcom_wcn_vddio_disable(struct pwrseq_device *pwrseq)
 {
 	struct pwrseq_qcom_wcn_ctx *ctx = pwrseq_device_get_drvdata(pwrseq);
 
-	return regulator_disable(ctx->vddio);
+	int ret = regulator_disable(ctx->vddio);
+
+	pwrseq_qcom_wcn_mark_off(ctx);
+	return ret;
 }
 
