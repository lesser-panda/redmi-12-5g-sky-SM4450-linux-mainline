new file mode 100644
index 000000000..1e85258e3
--- /dev/null
+++ b/sound/soc/codecs/fs1599.c
@@ -0,0 +1,335 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * FourSemi FS1599 analog-input speaker amplifier (I2C control only)
+ *
+ * The amplifier takes the analog AUX output of the codec (WCD937x on the Redmi 12 5G) and has no digital audio
+ * interface: all it needs is to be switched on before the stream starts and off afterwards.  This driver exposes it
+ * as a DAPM component (IN -> AMP -> OUT) that is used as an ASoC card aux-dev, so the codec AUX path powers it.
+ *
+ * The register values come from a vendor preset file ("firmware-name", .fsm, kept out of the source tree) and the
+ * power-up / power-down sequences of the vendor fs15xx module, re-implemented from tools/fs1599.py of the bring-up
+ * project (verified on the phone from userspace first).
+ *
+ * Bus format: 8-bit register, 16-bit big-endian value.
+ * Preset file (little endian, struct base B = 0x20):
+ *   u16 @B+0x1a  number of directory entries
+ *   directory @B+0x28: { u16 offset, u16 type }, the table is at B+0x28+offset
+ *   type 2 (common): u16 count, count * { u16 hdr, u16 val }
+ *   type 3 (scenes): u16 count, count * { u16 scene_mask, u16 hdr, u16 val }, applied if scene_mask & BIT(scene)
+ *   hdr 0xFxxx with bits 11:8 == 0: write reg (hdr & 0xff) = val
+ *   hdr 0xFxxx with bits 11:8 == 0xf: special entry, not supported (refused when parsing)
+ *   otherwise: bit field, len = (hdr >> 12) + 1, pos = (hdr >> 8) & 0xf, reg = hdr & 0xff: read-modify-write
+ */
+
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+#include <linux/unaligned.h>
+#include <sound/soc.h>
+
+#define FS1599_REG_ID_RESET	0x10
+#define FS1599_REG_STATUS	0x0e
+#define FS1599_REG_OUT_EN	0x11
+#define FS1599_REG_LOCK		0x1f
+#define FS1599_REG_BOOST	0xc0
+
+#define FS1599_STATUS_READY_A	0x0003
+#define FS1599_STATUS_READY_B	0x0300
+
+#define FS1599_FSM_BASE		0x20
+#define FS1599_FSM_NDIR		(FS1599_FSM_BASE + 0x1a)
+#define FS1599_FSM_DIR		(FS1599_FSM_BASE + 0x28)
+#define FS1599_FSM_COMMON	2
+#define FS1599_FSM_SCENES	3
+#define FS1599_DEFAULT_SCENE	6
+
+struct fs1599_entry {
+	u16 hdr;
+	u16 val;
+};
+
+struct fs1599 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct fs1599_entry *entries;	/* common table followed by the scene table, already filtered */
+	unsigned int num_entries;
+	bool on;
+};
+
+static const struct regmap_config fs1599_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 16,
+	.val_format_endian = REGMAP_ENDIAN_BIG,
+	.max_register = 0xff,
+	.cache_type = REGCACHE_NONE,
+};
+
+static int fs1599_apply_entry(struct fs1599 *fs, const struct fs1599_entry *e)
+{
+	u16 hdr = e->hdr;
+
+	if (hdr >= 0xf000 && (hdr & 0x0f00) == 0)
+		return regmap_write(fs->regmap, hdr & 0xff, e->val);
+
+	{
+		unsigned int len = (hdr >> 12) + 1, pos = (hdr >> 8) & 0xf;
+		unsigned int mask = (((1U << len) - 1) << pos) & 0xffff;
+
+		return regmap_update_bits(fs->regmap, hdr & 0xff, mask, (unsigned int)e->val << pos);
+	}
+}
+
+static int fs1599_reset_ready(struct fs1599 *fs)
+{
+	unsigned int v;
+	int i, ret;
+
+	for (i = 0; i < 5; i++) {
+		ret = regmap_write(fs->regmap, FS1599_REG_ID_RESET, 2);
+		if (ret)
+			return ret;
+		msleep(15);
+		ret = regmap_write(fs->regmap, FS1599_REG_ID_RESET, 1);
+		if (ret)
+			return ret;
+		ret = regmap_read(fs->regmap, FS1599_REG_STATUS, &v);
+		if (ret)
+			return ret;
+		if (v == FS1599_STATUS_READY_A || v == FS1599_STATUS_READY_B)
+			return 0;
+	}
+	dev_err(fs->dev, "not ready after 5 resets (status 0x%04x)\n", v);
+	return -EIO;
+}
+
+static int fs1599_power_on(struct fs1599 *fs)
+{
+	unsigned int i;
+	int ret;
+
+	ret = fs1599_reset_ready(fs);
+	if (ret)
+		return ret;
+
+	/* load preset */
+	ret = regmap_write(fs->regmap, FS1599_REG_LOCK, 0x0091);
+	for (i = 0; !ret && i < fs->num_entries; i++)
+		ret = fs1599_apply_entry(fs, &fs->entries[i]);
+	if (!ret)
+		ret = regmap_write(fs->regmap, FS1599_REG_LOCK, 0x0000);
+	if (ret)
+		return ret;
+
+	/* start up */
+	ret = regmap_write(fs->regmap, FS1599_REG_LOCK, 0xca91);
+	if (!ret)
+		ret = regmap_write(fs->regmap, FS1599_REG_BOOST, 0x0010);
+	if (!ret)
+		ret = regmap_write(fs->regmap, FS1599_REG_ID_RESET, 0x0000);
+	if (!ret)
+		ret = regmap_write(fs->regmap, FS1599_REG_OUT_EN, 0x00c0);
+	if (ret)
+		return ret;
+	msleep(10);
+	ret = regmap_write(fs->regmap, FS1599_REG_BOOST, 0x0000);
+	if (!ret)
+		ret = regmap_write(fs->regmap, FS1599_REG_LOCK, 0x0000);
+	return ret;
+}
+
+static int fs1599_power_off(struct fs1599 *fs)
+{
+	int ret;
+
+	ret = regmap_write(fs->regmap, FS1599_REG_OUT_EN, 0x0000);
+	msleep(20);
+	if (!ret)
+		ret = regmap_write(fs->regmap, FS1599_REG_ID_RESET, 0x0001);
+	return ret;
+}
+
+static int fs1599_amp_event(struct snd_soc_dapm_widget *w, struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
+	struct fs1599 *fs = snd_soc_component_get_drvdata(component);
+	int ret = 0;
+
+	switch (event) {
+	case SND_SOC_DAPM_POST_PMU:
+		if (!fs->num_entries) {
+			dev_err(fs->dev, "no preset loaded, amplifier stays off\n");
+			return -ENOENT;
+		}
+		ret = fs1599_power_on(fs);
+		if (ret)
+			dev_err(fs->dev, "power on failed: %d\n", ret);
+		else
+			fs->on = true;
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		if (fs->on) {
+			ret = fs1599_power_off(fs);
+			fs->on = false;
+		}
+		break;
+	}
+	return ret;
+}
+
+static const struct snd_soc_dapm_widget fs1599_dapm_widgets[] = {
+	SND_SOC_DAPM_INPUT("IN"),
+	SND_SOC_DAPM_PGA_E("AMP", SND_SOC_NOPM, 0, 0, NULL, 0, fs1599_amp_event,
+			   SND_SOC_DAPM_POST_PMU | SND_SOC_DAPM_PRE_PMD),
+	SND_SOC_DAPM_OUTPUT("OUT"),
+};
+
+static const struct snd_soc_dapm_route fs1599_dapm_routes[] = {
+	{ "AMP", NULL, "IN" },
+	{ "OUT", NULL, "AMP" },
+};
+
+static const struct snd_soc_component_driver fs1599_component = {
+	.dapm_widgets		= fs1599_dapm_widgets,
+	.num_dapm_widgets	= ARRAY_SIZE(fs1599_dapm_widgets),
+	.dapm_routes		= fs1599_dapm_routes,
+	.num_dapm_routes	= ARRAY_SIZE(fs1599_dapm_routes),
+};
+
+static int fs1599_parse_fsm(struct fs1599 *fs, const struct firmware *fw, u32 scene)
+{
+	const u8 *d = fw->data;
+	size_t size = fw->size;
+	u32 mask = BIT(scene);
+	size_t tab[4] = { 0 };
+	unsigned int n, i, nc = 0, ns = 0, k = 0;
+	size_t p;
+
+	if (size < FS1599_FSM_DIR)
+		return -EINVAL;
+	n = get_unaligned_le16(d + FS1599_FSM_NDIR);
+	if (n < 1 || n > 16 || FS1599_FSM_DIR + 4 * n > size)
+		return -EINVAL;
+	for (i = 0; i < n; i++) {
+		u16 off = get_unaligned_le16(d + FS1599_FSM_DIR + 4 * i);
+		u16 type = get_unaligned_le16(d + FS1599_FSM_DIR + 4 * i + 2);
+
+		if (type < ARRAY_SIZE(tab))
+			tab[type] = FS1599_FSM_DIR + off;
+	}
+	if (!tab[FS1599_FSM_COMMON] || !tab[FS1599_FSM_SCENES])
+		return -EINVAL;
+
+	p = tab[FS1599_FSM_COMMON];
+	if (p + 2 > size)
+		return -EINVAL;
+	nc = get_unaligned_le16(d + p);
+	if (p + 2 + 4 * nc > size)
+		return -EINVAL;
+	p = tab[FS1599_FSM_SCENES];
+	if (p + 2 > size)
+		return -EINVAL;
+	ns = get_unaligned_le16(d + p);
+	if (p + 2 + 6 * ns > size)
+		return -EINVAL;
+
+	fs->entries = devm_kcalloc(fs->dev, nc + ns, sizeof(*fs->entries), GFP_KERNEL);
+	if (!fs->entries)
+		return -ENOMEM;
+
+	p = tab[FS1599_FSM_COMMON] + 2;
+	for (i = 0; i < nc; i++, p += 4) {
+		fs->entries[k].hdr = get_unaligned_le16(d + p);
+		fs->entries[k].val = get_unaligned_le16(d + p + 2);
+		if (fs->entries[k].hdr >= 0x1000 && (fs->entries[k].hdr & 0x0f00) == 0x0f00)
+			return -EOPNOTSUPP;
+		k++;
+	}
+	p = tab[FS1599_FSM_SCENES] + 2;
+	for (i = 0; i < ns; i++, p += 6) {
+		if (!(get_unaligned_le16(d + p) & mask))
+			continue;
+		fs->entries[k].hdr = get_unaligned_le16(d + p + 2);
+		fs->entries[k].val = get_unaligned_le16(d + p + 4);
+		if (fs->entries[k].hdr >= 0x1000 && (fs->entries[k].hdr & 0x0f00) == 0x0f00)
+			return -EOPNOTSUPP;
+		k++;
+	}
+	fs->num_entries = k;
+	return 0;
+}
+
+static int fs1599_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	const struct firmware *fw;
+	const char *fwname = "foursemi/fs1599.fsm";
+	struct fs1599 *fs;
+	unsigned int status;
+	u32 scene = FS1599_DEFAULT_SCENE;
+	int ret;
+
+	fs = devm_kzalloc(dev, sizeof(*fs), GFP_KERNEL);
+	if (!fs)
+		return -ENOMEM;
+	fs->dev = dev;
+	fs->regmap = devm_regmap_init_i2c(client, &fs1599_regmap_config);
+	if (IS_ERR(fs->regmap))
+		return PTR_ERR(fs->regmap);
+	i2c_set_clientdata(client, fs);
+
+	device_property_read_string(dev, "firmware-name", &fwname);
+	device_property_read_u32(dev, "foursemi,scene", &scene);
+	if (scene > 15)
+		return dev_err_probe(dev, -EINVAL, "bad scene %u\n", scene);
+
+	/* the preset is built into the kernel (CONFIG_EXTRA_FIRMWARE): no race with the root file system */
+	ret = request_firmware(&fw, fwname, dev);
+	if (ret) {
+		dev_err(dev, "preset %s not found (%d): the amplifier will stay off\n", fwname, ret);
+	} else {
+		ret = fs1599_parse_fsm(fs, fw, scene);
+		release_firmware(fw);
+		if (ret)
+			dev_err(dev, "bad preset %s (%d): the amplifier will stay off\n", fwname, ret);
+		else
+			dev_info(dev, "preset %s: scene %u, %u register entries\n", fwname, scene, fs->num_entries);
+	}
+
+	/* informational only: do not fail the sound card if the chip does not answer */
+	if (regmap_read(fs->regmap, FS1599_REG_STATUS, &status))
+		dev_warn(dev, "no answer on the I2C bus\n");
+	else
+		dev_info(dev, "status register 0x%04x\n", status);
+
+	return devm_snd_soc_register_component(dev, &fs1599_component, NULL, 0);
+}
+
+static void fs1599_shutdown(struct i2c_client *client)
+{
+	struct fs1599 *fs = i2c_get_clientdata(client);
+
+	if (fs && fs->on)
+		fs1599_power_off(fs);
+}
+
+static const struct of_device_id fs1599_of_match[] = {
+	{ .compatible = "foursemi,fs1599" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, fs1599_of_match);
+
+static struct i2c_driver fs1599_i2c_driver = {
+	.driver = {
+		.name = "fs1599",
+		.of_match_table = fs1599_of_match,
+	},
+	.probe = fs1599_probe,
+	.shutdown = fs1599_shutdown,
+};
+module_i2c_driver(fs1599_i2c_driver);
+
+MODULE_DESCRIPTION("FourSemi FS1599 analog speaker amplifier (DAPM-controlled)");
+MODULE_LICENSE("GPL");
