From: Andy Zhang and contributors (see kernel/third-party/README.md for imported parts)
Subject: [PATCH 0007/8] Audio: RX macro fix, WCD937x, FS1599 speaker amplifier

lpass-rx-macro: fix the DSM clock register stride for codec >= 2.5 (needed for the speaker path; candidate for upstream).
wcd937x headphone TLV fix, aw88166 (ROCKNIX, unused), and fs1599.c: FS1599 speaker amplifier as an ASoC component (new, this project).

Apply with: git apply (from the root of a Linux 7.3 tree).
---
diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index 8e251e1d8..04342115a 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -1339,6 +1339,15 @@ config SND_SOC_FS_AMP_LIB
 	select CRC16
 	tristate
 
+config SND_SOC_FS1599
+	tristate "FourSemi FS1599 analog speaker amplifier (I2C controlled)"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  Analog-input speaker amplifier controlled over I2C only, powered through
+	  DAPM as an ASoC card aux-dev (Redmi 12 5G). Needs a vendor preset file
+	  (firmware-name) built into the kernel or in /lib/firmware.
+
 config SND_SOC_FS210X
 	tristate 'FourSemi FS2104/5S digital audio amplifier'
 	depends on I2C
diff --git a/sound/soc/codecs/Makefile b/sound/soc/codecs/Makefile
index 3d122ace7..74187b176 100644
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -143,6 +143,7 @@ snd-soc-es8389-y := es8389.o
 snd-soc-es9356-y := es9356.o
 snd-soc-framer-y := framer-codec.o
 snd-soc-fs-amp-lib-y := fs-amp-lib.o
+snd-soc-fs1599-y := fs1599.o
 snd-soc-fs210x-y := fs210x.o
 snd-soc-gtm601-y := gtm601.o
 snd-soc-hdac-hdmi-y := hdac_hdmi.o
@@ -587,6 +588,7 @@ obj-$(CONFIG_SND_SOC_ES8389)    += snd-soc-es8389.o
 obj-$(CONFIG_SND_SOC_ES9356)    += snd-soc-es9356.o
 obj-$(CONFIG_SND_SOC_FRAMER)	+= snd-soc-framer.o
 obj-$(CONFIG_SND_SOC_FS_AMP_LIB)+= snd-soc-fs-amp-lib.o
+obj-$(CONFIG_SND_SOC_FS1599)	+= snd-soc-fs1599.o
 obj-$(CONFIG_SND_SOC_FS210X)	+= snd-soc-fs210x.o
 obj-$(CONFIG_SND_SOC_GTM601)    += snd-soc-gtm601.o
 obj-$(CONFIG_SND_SOC_HDAC_HDMI) += snd-soc-hdac-hdmi.o
